# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=referral_system
DB_USER=root
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRE=30d

# External Activation Token Configuration
ACTIVATION_TOKEN_SECRET=your-external-activation-secret
ACTIVATION_TOKEN_ISSUER=external-registration-web
ACTIVATION_TOKEN_AUDIENCE=sena-agent-api
ACTIVATION_TOKEN_MAX_AGE=30m
ACTIVATION_RATE_LIMIT_WINDOW_MS=900000
ACTIVATION_RATE_LIMIT_MAX_REQUESTS=20

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Email Configuration (SENA SMTP)
MAIL_HOST=smtp.sena.co.th
MAIL_PORT=587
MAIL_USERNAME=pridesena@sena.co.th
MAIL_PASSWORD=SenaN3xT
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@sena.co.th
MAIL_FROM_NAME="SENA HAPPY REFER"

# Email Test Mode (Development/Safety)
# ถ้าตั้งค่า อีเมลทั้งหมดจะส่งไปที่อีเมลนี้แทนที่ผู้รับจริง
# ปล่อยว่างหรือคอมเมนต์ออกเพื่อส่งไปผู้รับจริง
MAIL_TEST_MODE_RECIPIENT=chanetw@sena.co.th

# Server-to-server Register API Key
# ใช้สำหรับ endpoint POST /api/auth/register
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ต้องตั้งค่าใน production — ถ้าไม่ตั้งค่า endpoint จะถูกบล็อกเพื่อความปลอดภัย
REGISTER_API_KEY=
REGISTER_API_RATE_LIMIT_WINDOW_MS=900000
REGISTER_API_RATE_LIMIT_MAX_REQUESTS=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log