# =============================================================
#  .env.extdb — Backend config สำหรับ External MySQL
#  แก้ไข DB_HOST, credentials, CORS ให้ตรงกับ environment จริง
# =============================================================

NODE_ENV=production
PORT=4000

# CORS — ใส่ IP/domain ของ frontend server
# ถ้า frontend อยู่ server เดียวกันกับ API:
CORS_ORIGIN=http://SERVER_IP:3000

# =============================================================
#  MySQL Database Configuration
#  
#  กรณี 1: MySQL อยู่บน server เดียวกับ Docker containers
#    → DB_HOST=host.docker.internal
#
#  กรณี 2: MySQL อยู่คนละ server
#    → DB_HOST=<IP ของ MySQL server>
# =============================================================
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=sena_user
DB_PASSWORD=sena_password
DB_NAME=sena_referral

# Authentication
JWT_SECRET=dev-secret-sena-referral-2024

# Server-to-server Register API Key
REGISTER_API_KEY=23ff3bf964027200920cb70f3b45a8a9d1e48465bbeb86233dc621c9e2a77274

# =============================================================
#  Email Configuration (SENA SMTP)
# =============================================================
MAIL_HOST=smtp.sena.co.th
MAIL_PORT=587
MAIL_USERNAME=pridesena@sena.co.th
MAIL_PASSWORD=SenaN3xT
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@sena.co.th
MAIL_FROM_NAME="SENA HAPPY REFER"

# Email Test Mode (เว้นว่าง = ส่งจริง)
MAIL_TEST_MODE_RECIPIENT=
MAIL_COPY_TEST_RECIPIENT=false
