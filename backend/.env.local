# ========================================
# LOCAL DEVELOPMENT CONFIG (No Docker)
# ========================================

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=localhost

# Database Configuration (Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sena_referral
DB_USER=sena_user
DB_PASSWORD=sena_password

# JWT Configuration
JWT_SECRET=dev-secret-sena-referral-2024-local
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=dev-refresh-secret-local
JWT_REFRESH_EXPIRE=30d

# External Activation Token Configuration
ACTIVATION_TOKEN_SECRET=external-activation-secret-local
ACTIVATION_TOKEN_ISSUER=external-registration-web
ACTIVATION_TOKEN_AUDIENCE=sena-agent-api
ACTIVATION_TOKEN_MAX_AGE=30m
ACTIVATION_RATE_LIMIT_WINDOW_MS=900000
ACTIVATION_RATE_LIMIT_MAX_REQUESTS=20

# CORS Configuration (Frontend URLs)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Email Configuration (SENA SMTP)
MAIL_HOST=smtp.sena.co.th
MAIL_PORT=587
MAIL_USERNAME=pridesena@sena.co.th
MAIL_PASSWORD=SenaN3xT
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@sena.co.th
MAIL_FROM_NAME="SENA HAPPY REFER"

# Test Mode - ส่งไปที่ chanetw@sena.co.th แทนผู้รับจริง
MAIL_TEST_MODE_RECIPIENT=chanetw@sena.co.th

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
